     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", \
"\"\<=============================================================\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<     AP63205WU CONVERTER ANALYSIS WITH SRU5018-4R7Y    \
      \>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", \
"\"\<=============================================================\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"duty", "=", 
     RowBox[{"Vout", "/", "Vin"}]}], ";", 
    RowBox[{"Pout", "=", 
     RowBox[{"Vout", "*", "Iout"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<[STATIC VALUES]\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Duty Cycle:                   \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"duty", "*", "100"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "2"}], "}"}]}], "]"}], ",", "\"\< %\>\""}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Output Power (Pout):          \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"Pout", ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "2"}], "}"}]}], "]"}], ",", "\"\< W\>\""}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"DeltaIL", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Vout", "*", 
        RowBox[{"(", 
         RowBox[{"Vin", "-", "Vout"}], ")"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"L", "*", "fsw", "*", "Vin"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Ipeak", "=", 
     RowBox[{"Iout", "+", 
      RowBox[{"(", 
       RowBox[{"DeltaIL", "/", "2.0"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"IrmsL", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"Iout", "^", "2"}], "+", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"DeltaIL", "^", "2"}], "/", "12.0"}], ")"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\\n[INDUCTOR CURRENT ANALYSIS]\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Inductor Ripple Current (\[CapitalDelta]IL):\>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"DeltaIL", ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "3"}], "}"}]}], "]"}], ",", "\"\< A (Ratio: \>\"", 
      ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"DeltaIL", "/", "Iout"}], ")"}], "*", "100"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}]}], "]"}], ",", "\"\< %)\>\""}], "]"}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Peak Inductor Current (Ipeak):\>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"Ipeak", ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "3"}], "}"}]}], "]"}], 
      ",", "\"\< A (Isat Limit: 2.0A)\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<RMS Inductor Current (Irms):  \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"IrmsL", ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "3"}], "}"}]}], "]"}], 
      ",", "\"\< A (Irms Limit: 1.55A)\>\""}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"PdcRLoss", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"IrmsL", "^", "2"}], ")"}], "*", "DCR"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"PcondHS", "=", 
     RowBox[{"duty", "*", 
      RowBox[{"(", 
       RowBox[{"Iout", "^", "2"}], ")"}], "*", "RdsOnHS"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"PcondLS", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1.0", "-", "duty"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"Iout", "^", "2"}], ")"}], "*", "RdsOnLS"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Pswitching", "=", 
     RowBox[{"0.5", "*", "Vin", "*", "Iout", "*", 
      RowBox[{"(", 
       RowBox[{"2.0", "*", "tTransition"}], ")"}], "*", "fsw"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"PgateCharge", "=", 
     RowBox[{"QgHS", "*", "Vgate", "*", "fsw"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"PlossesTotal", "=", 
     RowBox[{
     "PdcRLoss", "+", "PcondHS", "+", "PcondLS", "+", "Pswitching", "+", 
      "PgateCharge"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Efficiency", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Pout", "/", 
        RowBox[{"(", 
         RowBox[{"Pout", "+", "PlossesTotal"}], ")"}]}], ")"}], "*", 
      "100"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n[PRECISE LOSS & EFFICIENCY ANALYSIS]\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Inductor DCR Loss:            \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"PdcRLoss", "*", "1000"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "1"}], "}"}]}], "]"}], ",", "\"\< mW\>\""}], "]"}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<IC Conduction Loss (HS FET):  \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"PcondHS", "*", "1000"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "1"}], "}"}]}], "]"}], ",", "\"\< mW\>\""}], "]"}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<IC Conduction Loss (LS FET):  \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"PcondLS", "*", "1000"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "1"}], "}"}]}], "]"}], ",", "\"\< mW\>\""}], "]"}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<IC Switching Loss:            \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"Pswitching", "*", "1000"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "1"}], "}"}]}], "]"}], ",", "\"\< mW\>\""}], "]"}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total Power Loss:             \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"PlossesTotal", "*", "1000"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "1"}], "}"}]}], "]"}], ",", "\"\< mW\>\""}], "]"}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Estimated Total Efficiency:   \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"Efficiency", ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "2"}], "}"}]}], "]"}], ",", "\"\< %\>\""}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"DeltaVoutTarget", "=", 
     RowBox[{"0.01", "*", "Vout"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"CoutRippel", "=", 
     RowBox[{"DeltaIL", "/", 
      RowBox[{"(", 
       RowBox[{"8.0", "*", "fsw", "*", "DeltaVoutTarget"}], ")"}]}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"MaxESR", "=", 
     RowBox[{"DeltaVoutTarget", "/", "DeltaIL"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"CoutStability", "=", 
     RowBox[{"DeltaILastsprung", "/", 
      RowBox[{"(", 
       RowBox[{"2.0", "*", "Pi", "*", 
        RowBox[{"(", 
         RowBox[{"fsw", "*", "0.1"}], ")"}], "*", "DeltaVoutTarget"}], 
       ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"CoutRealRecommended", "=", 
     RowBox[{
      RowBox[{"Max", "[", 
       RowBox[{"CoutRippel", ",", "CoutStability"}], "]"}], "*", "2.0"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n[CORRECTED CAPACITOR ANALYSIS (COUT)]\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Recommended Real C (X7R):     \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"22.0", ",", 
          RowBox[{"CoutRealRecommended", "*", "1000000"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "1"}], "}"}]}], "]"}], ",", "\"\< \[Micro]F\>\""}],
      "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"CoutEffective", "=", 
     RowBox[{"CoutTest", "*", "0.65"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"DeltaVC", "=", 
     RowBox[{"DeltaIL", "/", 
      RowBox[{"(", 
       RowBox[{"8.0", "*", "fsw", "*", "CoutEffective"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"DeltaVESR", "=", 
     RowBox[{"DeltaIL", "*", "CoutEsr"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"DeltaVOutTotal", "=", 
     RowBox[{"DeltaVC", "+", "DeltaVESR"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n[REAL OUTPUT VOLTAGE RIPPLE ANALYSIS]\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total Peak-to-Peak Ripple:    \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"DeltaVOutTotal", "*", "1000"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "2"}], "}"}]}], "]"}], ",", "\"\< mV (\>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"DeltaVOutTotal", "/", "Vout"}], ")"}], "*", "100"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "3"}], "}"}]}], "]"}], 
      ",", "\"\< % of Vout)\>\""}], "]"}], ";"}], "\n", 
