      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "="}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Vin", "=", "24.0"}], ";"}], "        ", 
   RowBox[{"(*", 
    RowBox[{"Input", " ", "Voltage", " ", "in", " ", "V", " ", 
     RowBox[{"(", 
      RowBox[{"Adjusted", " ", "for", " ", "4.7", "uH", " ", "limit"}], 
      ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Vout", "=", "5.0"}], ";"}], "        ", 
   RowBox[{"(*", 
    RowBox[{"Fixed", " ", "5", "V", " ", "Output"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Iout", "=", "0.18"}], ";"}], "       ", 
   RowBox[{"(*", 
    RowBox[{"Output", " ", "Current", " ", "in", " ", "A"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"fsw", "=", 
     RowBox[{"1.1", "*", 
      RowBox[{"10", "^", "6"}]}]}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{"Fixed", " ", "Clock", " ", 
     RowBox[{"Frequency", ":", 
      RowBox[{"1.1", " ", "MHz"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"L", "=", 
     RowBox[{"4.7", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "6"}]}]}]}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Bourns", " ", "SRU5018"}], "-", 
     RowBox[{"4", "R7Y"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"DCR", "=", "0.036"}], ";"}], "       ", 
   RowBox[{"(*", 
    RowBox[{"Max", " ", "DCR", " ", "in", " ", "Ohms"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"IC", " ", 
     RowBox[{"Specifications", ":", 
      RowBox[{"Diodes", " ", 
       RowBox[{"Inc", ".", "AP63205WU"}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"RdsOnHS", "=", "0.125"}], ";", 
    RowBox[{"RdsOnLS", "=", "0.068"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tTransition", "=", 
     RowBox[{"5.0", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "9"}]}]}]}], ";", 
    RowBox[{"QgHS", "=", 
     RowBox[{"2.5", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "9"}]}]}]}], ";", 
    RowBox[{"Vgate", "=", "5.0"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"CoutTest", "=", 
     RowBox[{"22.0", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "6"}]}]}]}], ";", 
    RowBox[{"CoutEsr", "=", "0.005"}], ";", 
    RowBox[{"DeltaILastsprung", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
