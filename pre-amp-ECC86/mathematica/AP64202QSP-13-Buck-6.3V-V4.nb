     RowBox[{"\"\<C for Transient Stability:    \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"CoutStability", "*", "1000000"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "2"}], "}"}]}], "]"}], ",", "\"\< \[Micro]F\>\""}],
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Recommended Real C (X7R):     \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"22.0", ",", 
          RowBox[{"CoutRealRecommended", "*", "1000000"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "1"}], "}"}]}], "]"}], ",", "\"\< \[Micro]F\>\""}],
      "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"8.", " ", 
     RowBox[{"New", ":", 
      RowBox[{
      "Output", " ", "Voltage", " ", "Ripple", " ", "Verification"}]}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"CoutEffective", "=", 
     RowBox[{"CoutTest", "*", "0.60"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"DeltaVC", "=", 
     RowBox[{"DeltaIL", "/", 
      RowBox[{"(", 
       RowBox[{"8.0", "*", "fsw", "*", "CoutEffective"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"DeltaVESR", "=", 
     RowBox[{"DeltaIL", "*", "CoutEsr"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"DeltaVOutTotal", "=", 
     RowBox[{"DeltaVC", "+", "DeltaVESR"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n[REAL OUTPUT VOLTAGE RIPPLE ANALYSIS]\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Tested Output Capacitor:      \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"CoutTest", "*", "1000000"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "1"}], "}"}]}], "]"}], 
      ",", "\"\< \[Micro]F (Effective Cap via DC Bias: \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"CoutEffective", "*", "1000000"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "1"}], "}"}]}], "]"}], 
      ",", "\"\< \[Micro]F)\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Capacitive Voltage Ripple:    \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"DeltaVC", "*", "1000"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "2"}], "}"}]}], "]"}], ",", "\"\< mV\>\""}], "]"}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<ESR-Induced Voltage Ripple:   \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"DeltaVESR", "*", "1000"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "2"}], "}"}]}], "]"}], ",", "\"\< mV\>\""}], "]"}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total Peak-to-Peak Ripple:    \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"DeltaVOutTotal", "*", "1000"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "2"}], "}"}]}], "]"}], ",", "\"\< mV (\>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"DeltaVOutTotal", "/", "Vout"}], ")"}], "*", "100"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "3"}], "}"}]}], "]"}], 
      ",", "\"\< % of Vout)\>\""}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"7.", " ", "EMI", " ", "Filter", " ", "Design"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f0", "=", 
     RowBox[{"1.0", "/", 
      RowBox[{"(", 
       RowBox[{"2.0", "*", "Pi", "*", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Lemc", "*", "Cemc"}], "]"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"AttenuatondB", "=", 
     RowBox[{"40.0", "*", 
      RowBox[{"Log", "[", 
       RowBox[{"10", ",", 
        RowBox[{"fsw", "/", "f0"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"RinConverter", "=", 
     RowBox[{
      RowBox[{"Vin", "^", "2"}], "/", 
      RowBox[{"(", 
       RowBox[{"Pout", "+", "PlossesTotal"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Z0", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"Lemc", "/", "Cemc"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"CdMin", "=", 
     RowBox[{"4.0", "*", "Cemc"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"RdOpt", "=", 
     RowBox[{"1.0", "*", "Z0"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\\n[EMI FILTER DESIGN (PI-FILTER)]\>\"", "]"}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Filter Resonance Freq (f0):   \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"f0", "/", "1000.0"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "1"}], "}"}]}], "]"}], ",", "\"\< kHz\>\""}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Theoretical Attenuation @1MHz:\>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"AttenuatondB", ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}]}], "]"}], ",", "\"\< dB\>\""}], "]"}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Filter Characteristic Imp (Z0):\>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"Z0", ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "2"}], "}"}]}], "]"}], 
      ",", "\"\< \[CapitalOmega]\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Damping Electrolytic Cap (Cd):\>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"CdMin", "*", "1000000"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "1"}], "}"}]}], "]"}], ",", "\"\< \[Micro]F\>\""}],
      "]"}], ";"}], "\n", 
