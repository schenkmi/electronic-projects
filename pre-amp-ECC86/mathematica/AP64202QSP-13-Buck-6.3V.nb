Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "INPUT"}]}], " ", 
     RowBox[{"PARAMETERS", "--"}]}], "-"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"Vin", "=", "35.0"}], ";"}], "       ", 
   RowBox[{"(*", 
    RowBox[{"Eingangsspannung", " ", "in", " ", "V"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Vout", "=", "6.3"}], ";"}], "       ", 
   RowBox[{"(*", 
    RowBox[{"Ausgangsspannung", " ", "in", " ", "V"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Iout", "=", "0.66"}], ";"}], "      ", 
   RowBox[{"(*", 
    RowBox[{"Ausgangsstrom", " ", "in", " ", "A"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"fsw", "=", 
     RowBox[{"10", "^", "6"}]}], ";"}], "       ", 
   RowBox[{"(*", 
    RowBox[{"Schaltfrequenz", ":", 
     RowBox[{"1", " ", "MHz"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"L", "=", 
     RowBox[{"15", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "6"}]}]}]}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{"Induktivit\[ADoubleDot]t", ":", 
     RowBox[{"15", " ", "uH"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Vfb", "=", "0.8"}], ";"}], "        ", 
   RowBox[{"(*", 
    RowBox[{"Feedback", "-", 
     RowBox[{"Referenzspannung", " ", "des", " ", "AP64202Q"}]}], "*)"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", 
       RowBox[{"CALCULATIONS", "--"}]}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<=== Buck Converter Analysis (AP64202Q + SRU8043-150Y) \
===\>\"", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", "Duty", " ", "Cycle"}], "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"duty", "=", 
     RowBox[{"Vout", "/", "Vin"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Duty Cycle (duty): \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"duty", "*", "100"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "2"}], "}"}]}], "]"}], ",", "\"\< %\>\""}], "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Inductor", " ", "Ripple", " ", "Current"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DeltaIL", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Vout", "*", 
        RowBox[{"(", 
         RowBox[{"Vin", "-", "Vout"}], ")"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"L", "*", "fsw", "*", "Vin"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Inductor Ripple Current (\[CapitalDelta]IL): \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"DeltaIL", ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "3"}], "}"}]}], "]"}], ",", "\"\< A\>\""}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Ripple Percentage: \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"DeltaIL", "/", "Iout"}], ")"}], "*", "100"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "1"}], "}"}]}], "]"}], ",", "\"\< %\>\""}], "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Peak", " ", "Current"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Ipeak", "=", 
     RowBox[{"Iout", "+", 
      RowBox[{"(", 
       RowBox[{"DeltaIL", "/", "2"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Peak Inductor Current (Ipeak): \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"Ipeak", ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "3"}], "}"}]}], "]"}], ",", "\"\< A\>\""}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Safety Margin to Isat (2.0A): \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"2.0", "-", "Ipeak"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "3"}], "}"}]}], "]"}], ",", "\"\< A\>\""}], "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", "Feedback", " ", "Resistor", " ", "Network", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Assuming", " ", "R2"}], "=", 
       RowBox[{"10", " ", "kOhm"}]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"R2", "=", "10000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"R1", "=", 
     RowBox[{"R2", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Vout", "/", "Vfb"}], ")"}], "-", "1"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\\n=== External Components ===\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Feedback Resistor R1 (Top): \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"R1", "/", "1000"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "2"}], "}"}]}], "]"}], 
      ",", "\"\< k\[CapitalOmega] (Standard: 68.1 k\[CapitalOmega] + 680 \
\[CapitalOmega])\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Feedback Resistor R2 (Bottom): \>\"", ",", 
      RowBox[{"R2", "/", "1000"}], ",", "\"\< k\[CapitalOmega]\>\""}], "]"}], 
    ";"}], "\n", "\n"}]}]], "Input",
 CellChangeTimes->{{3.997442444968665*^9, 3.997442444968701*^9}, {
