   RowBox[{"(*", 
    RowBox[{"7.", " ", "EMI", " ", "Filter", " ", "Design"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f0", "=", 
     RowBox[{"1.0", "/", 
      RowBox[{"(", 
       RowBox[{"2.0", "*", "Pi", "*", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Lemc", "*", "Cemc"}], "]"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"AttenuatondB", "=", 
     RowBox[{"40.0", "*", 
      RowBox[{"Log", "[", 
       RowBox[{"10", ",", 
        RowBox[{"fsw", "/", "f0"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"RinConverter", "=", 
     RowBox[{
      RowBox[{"Vin", "^", "2"}], "/", 
      RowBox[{"(", 
       RowBox[{"Pout", "+", "PlossesTotal"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Z0", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"Lemc", "/", "Cemc"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"CdMin", "=", 
     RowBox[{"4.0", "*", "Cemc"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"RdOpt", "=", 
     RowBox[{"1.0", "*", "Z0"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\\n[EMI FILTER DESIGN (PI-FILTER)]\>\"", "]"}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Filter Resonance Freq (f0):   \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"f0", "/", "1000.0"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "1"}], "}"}]}], "]"}], ",", "\"\< kHz\>\""}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Theoretical Attenuation @1MHz:\>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"AttenuatondB", ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}]}], "]"}], ",", "\"\< dB\>\""}], "]"}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Filter Characteristic Imp (Z0):\>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"Z0", ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "2"}], "}"}]}], "]"}], 
      ",", "\"\< \[CapitalOmega]\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Damping Electrolytic Cap (Cd):\>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"CdMin", "*", "1000000"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "1"}], "}"}]}], "]"}], ",", "\"\< \[Micro]F\>\""}],
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Damping Resistor (Rd):        \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"RdOpt", ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "2"}], "}"}]}], "]"}], 
      ",", "\"\< \[CapitalOmega]\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", \
"\"\<=============================================================\>\"", 
     "]"}], ";"}], "\n"}]}]], "Input",
